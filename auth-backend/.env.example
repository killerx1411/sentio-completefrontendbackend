FLASK_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/sentio_auth

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sentiomind.com
SMTP_USE_TLS=true
