# Sentio B2B / Auth backend — environment template.
#
# This file is COMMITTED. It must never contain a real secret, a real DSN or a
# real credential — only placeholders. Copy it, never edit it in place:
#
#   local dev  : cp .env.example .env.local   and fill in local values
#   production : do NOT create a .env. Cloud Run supplies every variable below
#                as a plain env var or a Secret Manager reference.
#                See .env.production.example and DEPLOYMENT_PRODUCTION.md.
#
# Verify the DB connection: python -c "from auth.db_connection import init_auth_db; init_auth_db()"

# ─── Environment ────────────────────────────────────────────────────────────
# One of: development | production | test. Required — there is no default.
FLASK_ENV=development
# Cloud Run injects PORT (8080). Locally anything free.
PORT=5000

# ─── Secrets (generate your own; never reuse across environments) ───────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_min_32_chars
# python -c "import secrets; print(secrets.token_hex(32))"
MFA_ENCRYPTION_KEY=CHANGE_ME_64_char_hex

# ─── PostgreSQL (external; never a container-local server in production) ────
SENTIO_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# require | verify-ca | verify-full in production. disable/prefer for local dev.
SENTIO_DB_SSLMODE=disable

# ─── Rate limiting / Redis ──────────────────────────────────────────────────
# Production MUST be redis:// or rediss:// — memory:// is per-process and does
# not rate-limit across Cloud Run instances or gunicorn workers, so the app
# refuses to start with it (auth/config.py: validate_config).
RATELIMIT_STORAGE_URI=memory://
# Optional shared cache/lockout store. Required when FLASK_ENV=production.
REDIS_URL=

# ─── Origins ────────────────────────────────────────────────────────────────
# Production: https://product.sentiomind.in — no wildcard, no localhost, https only.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Number of trusted reverse proxies in front of the app (Cloud Run: 1).
TRUSTED_PROXY_COUNT=1

# ─── Email (SMTP_PASSWORD is required when FLASK_ENV=production) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ─── Policy ─────────────────────────────────────────────────────────────────
# Must be true in production (enforced by validate_config).
STRICT_PASSWORD_BREACH_CHECK=false
ENABLE_OPEN_REGISTRATION=false
MAX_LOGIN_ATTEMPTS=5
MAX_IP_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
TEMP_PASSWORD_EXPIRY_HOURS=12
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ─── Consumer applications (one auth authority, many products) ──────────────
# Registered applications: sentio-b2b, sentio-mobile (auth/constants/applications.py).
#
# SERVICE_APPLICATIONS — the RESOURCE SERVER boundary. Which applications'
# access tokens this deployment's business routes accept.
#   sentio-b2b     → B2B/stakeholder routes only (the production B2B value)
#   sentio-mobile  → Sentio Mobile Admin backend only
#   unset/empty    → every registered application
SERVICE_APPLICATIONS=sentio-b2b
#
# AUTH_AUTHORITY_APPLICATIONS — the AUTHORITY boundary. Which applications this
# deployment mints and identifies tokens for (/api/auth/me, /api/auth/introspect,
# first-login password change, MFA enrolment). b2bapi.sentiomind.in is the one
# authority for BOTH products, so leave this unset (= all registered apps).
# Narrowing it to sentio-b2b would make the authority reject the sentio-mobile
# tokens it just minted, and Mobile Admin login would break.
# AUTH_AUTHORITY_APPLICATIONS=

# ─── Gunicorn (production) ──────────────────────────────────────────────────
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=120
# GUNICORN_BIND_HOST=0.0.0.0     # Cloud Run requires 0.0.0.0; 127.0.0.1 behind nginx

# ─── CV / analysis system (cv_analysis package) ─────────────────────────────
# All optional and irrelevant to this service — the auth/B2B image does not
# contain cv_analysis and never imports it. Listed only for the combined
# deployment (test_db:app), which needs requirements-cv.txt.
# CV_INPUT_VIDEOS_DIR=input_videos
# CV_PROFILES_DIR=profiles
# CV_SNAPSHOTS_DIR=snapshots
# CV_ANALYSIS_DIR=analysis_results
# CV_SIMILARITY_THRESHOLD=0.48
# CV_FRAME_DIFFERENCE_THRESHOLD=0.15
# CV_RATELIMIT_ANALYSIS=60/minute
# CV_MAX_IMAGE_BYTES=2097152
# CV_PORT=5002
# CV_DATABASE_URL=
