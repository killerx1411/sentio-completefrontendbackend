# Production configuration for https://b2bapi.sentiomind.in (Cloud Run).
#
# THIS IS A REFERENCE, NOT A FILE TO DEPLOY. Do not create a .env in the
# production image — .dockerignore excludes it, and a secret baked into a layer
# is readable by anyone who can pull the image.
#
# The values marked SECRET below are set on the Cloud Run service as Secret
# Manager references (`--set-secrets`), never as `--set-env-vars`.
# See DEPLOYMENT_PRODUCTION.md for the exact commands.

# ─── Plain environment variables (--set-env-vars) ───────────────────────────
FLASK_ENV=production
# PORT is injected by Cloud Run (8080). Do not set it yourself.

FRONTEND_URL=https://product.sentiomind.in
ALLOWED_ORIGINS=https://product.sentiomind.in
# Cloud Run terminates TLS and adds exactly one X-Forwarded-For hop.
TRUSTED_PROXY_COUNT=1
PREFERRED_URL_SCHEME=https

SENTIO_DB_SSLMODE=require

# Resource-server boundary: B2B business routes accept sentio-b2b tokens only,
# so a Mobile Admin token can never be replayed against them.
SERVICE_APPLICATIONS=sentio-b2b
# Authority boundary: left UNSET on purpose. This deployment is the single
# authentication authority for both products and must be able to mint and
# identify sentio-mobile tokens for the Mobile Admin pages of the B2B console.
# AUTH_AUTHORITY_APPLICATIONS=

STRICT_PASSWORD_BREACH_CHECK=true
ENABLE_OPEN_REGISTRATION=false
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
MAX_LOGIN_ATTEMPTS=5
MAX_IP_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
TEMP_PASSWORD_EXPIRY_HOURS=12

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@sentiomind.in
SMTP_USER=no-reply@sentiomind.in
SMTP_USE_TLS=true

GUNICORN_WORKERS=4
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ─── Secret Manager references (--set-secrets) ──────────────────────────────
# SECRET  JWT_SECRET_KEY      -> projects/PROJECT/secrets/b2b-jwt-secret-key
# SECRET  MFA_ENCRYPTION_KEY  -> projects/PROJECT/secrets/b2b-mfa-encryption-key
# SECRET  SENTIO_DB_URL       -> projects/PROJECT/secrets/b2b-db-url
#           postgresql://USER:PASSWORD@HOST:5432/DBNAME
#           MUST be the B2B database. The Sentio Mobile database is separate and
#           must never appear here.
# SECRET  RATELIMIT_STORAGE_URI -> projects/PROJECT/secrets/b2b-ratelimit-uri
#           rediss://default:TOKEN@HOST:6379   (Upstash / Memorystore)
#           memory:// is rejected at startup.
# SECRET  REDIS_URL           -> projects/PROJECT/secrets/b2b-redis-url
# SECRET  SMTP_PASSWORD       -> projects/PROJECT/secrets/b2b-smtp-password
