# Frontend environment (Create React App)
#
# Local dev (`npm start`):
#   Uses .env.development automatically → localhost:5000
#   Optional: copy .env.development.local.example → .env.development.local
#
# Production (`npm run build`):
#   Uses .env.production → api.sentiomind.in, same-origin auth

# Analytics / video API
REACT_APP_API_URL=https://api.sentiomind.in

# JWT auth API — empty = same-origin in production (nginx /api/ proxy)
REACT_APP_AUTH_API_URL=

# Sentio Mobile backend (FastAPI) — serves the Mobile Admin API at /api/admin.
# Empty = same-origin. Local dev: http://localhost:8000
REACT_APP_MOBILE_ADMIN_API_URL=
