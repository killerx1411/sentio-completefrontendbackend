# Used by `npm run build` (production deploy to https://product.sentiomind.in).
#
# CRA inlines every REACT_APP_* value into the JavaScript bundle at build time.
# They are PUBLIC — anyone can read them in devtools. Only origins belong here;
# never an API key, a token, or a database URL.

# ─── B2B backend (Flask auth/RBAC authority) ────────────────────────────────
# Absolute, not empty: the SPA is served from product.sentiomind.in while the
# API lives on b2bapi.sentiomind.in, so a same-origin "" base would resolve to
# https://product.sentiomind.in/api/... and 404 against the static host.
REACT_APP_API_URL=https://b2bapi.sentiomind.in
REACT_APP_AUTH_API_URL=https://b2bapi.sentiomind.in

# ─── Sentio Mobile backend (FastAPI) — serves /api/admin ────────────────────
# The Mobile Admin pages of this console read every value through this origin.
# The frontend never touches the Mobile database directly.
REACT_APP_MOBILE_ADMIN_API_URL=https://api.sentiomind.in

# Do not ship source maps: they republish the full readable frontend source,
# including the shape of every admin API call, to anyone who opens devtools.
GENERATE_SOURCEMAP=false

# Treat lint warnings as warnings, not build failures, on CI.
CI=false
